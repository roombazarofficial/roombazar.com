# Copy to .env and fill in. Never commit .env itself.

# The API this console talks to.
NEXT_PUBLIC_API_URL=http://localhost:4000

# The public site. Used for the "Public site" link and to send unauthenticated
# operators to sign in, since this app has no auth UI of its own.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host serving listing photos, shown in the approval queue.
NEXT_PUBLIC_IMAGE_HOST=images.roombazar.com
