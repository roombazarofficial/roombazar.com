# Copy to .env and fill in. Never commit .env itself.

# Public site origin, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API. The frontend is a separate deployment, so this is absolute.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Host that serves listing photos. Must match next.config.ts remotePatterns.
NEXT_PUBLIC_IMAGE_HOST=images.roombazar.com

# Map tiles for the fuzzed locality circle on listing pages.
NEXT_PUBLIC_MAP_TILE_URL=

# Analytics, optional in local development.
NEXT_PUBLIC_ANALYTICS_ID=
