# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Origins allowed to send credentialed requests. Comma-separated.
# A wildcard here combined with credentials would let any site act as a
# signed-in user, so keep this exact.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively: CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Transactional email for signup and password-reset OTP codes.
# Resend is the simplest option. Verify your sending domain before production.
MAIL_DRIVER=resend
MAIL_FALLBACK=off
MAIL_FROM=RoomBazar <no-reply@your-verified-domain.com>
RESEND_API_KEY=

# Alternatively use SMTP (for Gmail, use an App Password, not your account password).
# MAIL_DRIVER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# Clerk. From the Clerk dashboard: API Keys.
CLERK_SECRET_KEY=sk_test_replaceme
CLERK_PUBLISHABLE_KEY=pk_test_replaceme
# Clerk dashboard: Webhooks. Signs the payloads that keep our user table in sync.
CLERK_WEBHOOK_SECRET=whsec_replaceme

# Not read until the persistence layer lands.
DATABASE_URL=

# Cloudflare R2 for listing photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_HOST=images.roombazar.com
